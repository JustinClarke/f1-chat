  step 1 SQL: SELECT r.Abbreviation, ds.full_name, COUNT(*) as races, STDDEV_SAMP(r.Position) as pos_stddev, AVG(r.Position) as avg_pos
FROM results r
JOIN driver_seasons ds ON r.Abbreviation = ds.driver_code AND r.season = ds.season
WHERE r.session = 'R'
GROUP BY r.Abbreviation, ds.full_name
ORDER BY pos_stddev ASC

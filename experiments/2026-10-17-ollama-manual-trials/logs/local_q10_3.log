QUESTION: Did any driver finish a 2024 race with fewer laps than the winner of that race? If so, list the driver, the race, and how many laps fewer.
== run 1 ==
    [model] done_reason=stop eval_count=1187 prompt_eval_count=3540 thinking_chars=3421 content_chars=0
  step 1 SQL: WITH winner AS (
  SELECT r.race, r.Abbreviation as winner_driver, r.FullName as winner_name
  FROM results r
  WHERE r.session='R' AND r.Position=1
),
winner_laps AS (
  SELECT w.race, w.winner_driver, max(l.LapNumber) as winner_laps
  FROM winner w
  JOIN laps l ON l.race=w.race AND l.Driver=w.winner_driver AND l.session='R'
  GROUP BY w.race, w.winner_driver
),
driver_laps AS (
  SELECT l.race, l.Driver, max(l.LapNumber) as driver_laps
  FROM laps l
  WHERE l.session='R'
  GROUP BY l.race, l.Driver
),
classified AS (
  SELECT r.race, r.Abbreviation as driver, r.FullName as driver_name
  FROM results r
  WHERE r.session='R' AND (
    r.Status='Finished' OR r.Status LIKE '+%' OR r.Status='Lapped'
  )
)
SELECT c.driver_name, c.race, w.winner_laps - d.driver_laps as laps_fewer
FROM classified c
JOIN driver_laps d ON d.race=c.race AND d.Driver=c.driver
JOIN winner_laps w ON w.race=c.race
WHERE d.driver_laps < w.winner_laps
ORDER BY c.race, laps_fewer DESC;

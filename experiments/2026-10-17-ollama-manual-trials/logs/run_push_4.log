  FROM results r
  JOIN lap_counts l ON r.race = l.race AND r.Abbreviation = l.Driver
  WHERE r.session='R'
    AND r.Status NOT LIKE '%Retired%'
    AND r.Status NOT LIKE '%Disqualified%'
    AND r.Status NOT LIKE '%Excluded%'
    AND r.Status NOT LIKE '%Withdrawn%'
),
filtered AS (
  SELECT dl.race, ds.full_name AS driver_name, (wl.winner_lap_count - dl.lap_count) AS laps_fewer
  FROM driver_lap_counts dl
  JOIN winner_laps wl ON dl.race = wl.race
  JOIN driver_seasons ds ON dl.driver = ds.driver_code AND ds.season=2024
  WHERE (wl.winner_lap_count - dl.lap_count) > 0
)
SELECT race, COUNT(*) AS drivers_fewer, MAX(laps_fewer) AS max_laps_fewer
FROM filtered
GROUP BY race
ORDER BY race;

QUESTION: Did any driver finish a 2024 race with fewer laps than the winner of that race? If so, list the driver, the race, and how many laps fewer.
== run 1 ==
    [model] done_reason=stop eval_count=1506 prompt_eval_count=3581 thinking_chars=4151 content_chars=0
  step 1 SQL: WITH driver_laps AS (
  SELECT race, Abbreviation, MAX(LapNumber) AS laps_completed
  FROM laps
  WHERE session='R'
  GROUP BY race, Abbreviation
),
winner_laps AS (
  SELECT r.race, r.Abbreviation AS winner, dl.laps_completed AS winner_laps
  FROM results r
  JOIN driver_laps dl ON r.race=dl.race AND r.Abbreviation=dl.Abbreviation
  WHERE r.session='R' AND r.Position=1
),
finishers AS (
  SELECT r.race, r.Abbreviation, dl.laps_completed
  FROM results r
  JOIN driver_laps dl ON r.race=dl.race AND r.Abbreviation=dl.Abbreviation
  WHERE r.session='R' AND (
    r.Status LIKE 'Finished%' OR r.Status LIKE 'Lapped%' OR r.Status LIKE '+% Lap%'
  )
)
SELECT f.race, ds.full_name AS driver, f.laps_completed, w.winner_laps, (w.winner_laps - f.laps_completed) AS laps_fewer
FROM finishers f
JOIN winner_laps w ON f.race=w.race
JOIN driver_seasons ds ON f.Abbreviation=ds.driver_code AND ds.season=2024
WHERE f.Abbreviation <> w.winner
  AND f.laps_completed < w.winner_laps
ORDER BY f.race, laps_fewer DESC;

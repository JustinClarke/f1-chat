##### q11 (cloudflare gpt-oss-20b, v4 prompt, 1 run): Who was the best qualifier in the 2024 season?
== run 1 ==
  step 1 SQL: SELECT r.Abbreviation, ds.full_name, COUNT(*) AS poles
FROM results r
JOIN driver_seasons ds ON r.Abbreviation = ds.driver_code AND r.season = ds.season
WHERE r.session = 'Q' AND r.Position = 1
GROUP BY r.Abbreviation, ds.full_name
ORDER BY poles DESC
LIMIT 5;
steps=1 ANSWER: 'The driver with the most pole positions in the 2024 season was **Max\u202fVerstappen** – he secured 10 poles.'
##### q12 (cloudflare gpt-oss-20b, v4 prompt, 1 run): In how many 2024 Grand Prix races did the driver who set the fastest qualifying lap go on to win the race? Give the count.
== run 1 ==
  step 1 SQL: WITH qual_laps AS (
  SELECT race, Abbreviation, LapTime
  FROM laps
  WHERE session='Q' AND LapTime IS NOT NULL AND Deleted IS NOT TRUE
),
ranked AS (
  SELECT race, Abbreviation, LapTime,
         ROW_NUMBER() OVER (PARTITION BY race ORDER BY LapTime ASC) AS rn
  FROM qual_laps
),
fastest AS (
  SELECT race, Abbreviation
  FROM ranked
  WHERE rn = 1
)
SELECT COUNT(*) AS count
FROM fastest f
JOIN results r
  ON r.race = f.race AND r.session='R' AND r.Position=1 AND r.Abbreviation = f.Abbreviation;
  step 2 SQL: WITH qual_laps AS (
  SELECT race, Driver, LapTime
  FROM laps
  WHERE session='Q' AND LapTime IS NOT NULL AND Deleted IS NOT TRUE
),
ranked AS (
  SELECT race, Driver, LapTime,
         ROW_NUMBER() OVER (PARTITION BY race ORDER BY LapTime ASC) AS rn
  FROM qual_laps
),
fastest AS (
  SELECT race, Driver
  FROM ranked
  WHERE rn = 1
)
SELECT COUNT(*) AS count
FROM fastest f
JOIN results r
  ON r.race = f.race AND r.session='R' AND r.Position=1 AND r.Abbreviation = f.Driver;
steps=2 ANSWER: '11 races.'

  step 1 SQL: WITH driver_laps AS (
  SELECT race, Driver, max(LapNumber) AS laps_completed
  FROM laps
  WHERE session='R'
  GROUP BY race, Driver
),
winner_laps AS (
  SELECT race, max(laps_completed) AS winner_laps
  FROM driver_laps
  GROUP BY race
),
classified_results AS (
  SELECT r.race, r.Abbreviation, r.Status
  FROM results r
  WHERE r.session='R' AND (r.Status='Finished' OR r.Status='Lapped' OR r.Status LIKE '+% Lap')
)
SELECT ds.full_name AS driver, dl.race, (wl.winner_laps - dl.laps_completed) AS laps_fewer
FROM driver_laps dl
JOIN winner_laps wl ON dl.race = wl.race
JOIN classified_results cr ON dl.race = cr.race AND dl.Driver = cr.Abbreviation
JOIN driver_seasons ds ON ds.driver_code = dl.Driver AND ds.season = 2024
WHERE dl.laps_completed < wl.winner_laps
ORDER BY dl.race, laps_fewer DESC;

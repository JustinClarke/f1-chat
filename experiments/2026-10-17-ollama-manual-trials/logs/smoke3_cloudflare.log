== run 1 ==
  step 1 SQL: SELECT l.Driver, COUNT(DISTINCT l.PitInTime) AS pit_stops
FROM laps l
WHERE l.race = 'bahrain_grand_prix' AND l.session = 'R' AND l.PitInTime IS NOT NULL
GROUP BY l.Driver
ORDER BY pit_stops DESC
LIMIT 5;
  step 2 SQL: SELECT ds.full_name, l.Driver, COUNT(DISTINCT l.PitInTime) AS pit_stops
FROM laps l
JOIN driver_seasons ds ON ds.driver_code = l.Driver AND ds.season = 2024
WHERE l.race = 'bahrain_grand_prix' AND l.session = 'R' AND l.PitInTime IS NOT NULL
GROUP BY ds.full_name, l.Driver
ORDER BY pit_stops DESC
LIMIT 5;

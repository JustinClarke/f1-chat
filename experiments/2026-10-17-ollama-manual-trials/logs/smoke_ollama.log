  step 1 SQL: SELECT Driver, COUNT(DISTINCT PitInTime) AS pit_stops
FROM laps
WHERE race = 'bahrain_grand_prix' AND session = 'R'
GROUP BY Driver
ORDER BY pit_stops DESC
LIMIT 10;
  step 2 SQL: SELECT ds.full_name, COUNT(DISTINCT l.PitInTime) AS pit_stops
FROM laps l
JOIN driver_seasons ds ON l.Driver = ds.driver_code AND ds.season = 2024
WHERE l.race = 'bahrain_grand_prix' AND l.session = 'R'
GROUP BY ds.full_name
ORDER BY pit_stops DESC
LIMIT 10;

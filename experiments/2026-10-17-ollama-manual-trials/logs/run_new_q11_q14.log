##### q12: In how many 2024 Grand Prix races did the driver who set the fastest qualifying lap go on to win the race? Give the count.
== run 1 ==
  step 1 SQL: SELECT COUNT(DISTINCT q.race) AS races
FROM results q
JOIN results r ON q.race = r.race AND q.Abbreviation = r.Abbreviation
WHERE q.session = 'Q' AND q.Position = 1
  AND r.session = 'R' AND r.Position = 1;
steps=1 ANSWER: '12 races.'
== run 2 ==
  step 1 SQL: SELECT COUNT(DISTINCT r_q.race) AS count
FROM results r_q
JOIN results r_r ON r_q.race = r_r.race
WHERE r_q.session='Q' AND r_q.Position=1
  AND r_r.session='R' AND r_r.Position=1;
  step 2 SQL: SELECT r_q.race, r_q.FullName AS pole_driver, r_r.FullName AS winner
FROM results r_q
JOIN results r_r ON r_q.race = r_r.race
WHERE r_q.session='Q' AND r_q.Position=1
  AND r_r.session='R' AND r_r.Position<>1
ORDER BY r_q.race;
  step 3 SQL: SELECT COUNT(DISTINCT r_q.race) AS count
FROM results r_q
JOIN results r_r ON r_q.race = r_r.race AND r_q.Abbreviation = r_r.Abbreviation
WHERE r_q.session='Q' AND r_q.Position=1
  AND r_r.session='R' AND r_r.Position=1;
steps=3 ANSWER: '12 races.'
== run 3 ==
  step 1 SQL: WITH fastest_q AS (
  SELECT race, Abbreviation, MIN(Q3) AS min_q3
  FROM results
  WHERE session='Q' AND Q3 IS NOT NULL
  GROUP BY race, Abbreviation
),
race_min_q AS (
  SELECT race, MIN(min_q3) AS race_min_q
  FROM fastest_q
  GROUP BY race
),
driver_fastest_q AS (
  SELECT fq.race, fq.Abbreviation
  FROM fastest_q fq
  JOIN race_min_q rmq ON fq.race = rmq.race AND fq.min_q3 = rmq.race_min_q
)
SELECT COUNT(DISTINCT dfq.race) AS races_with_fastest_q_winner
FROM driver_fastest_q dfq
JOIN results r ON r.race = dfq.race AND r.session='R' AND r.Abbreviation = dfq.Abbreviation AND r.Position = 1;
steps=1 ANSWER: '13 races.'

JOIN driver_seasons ds ON r.Abbreviation = ds.driver_code AND r.season = ds.season
WHERE r.session = 'R'
GROUP BY r.Abbreviation, ds.full_name
ORDER BY pos_stddev ASC
LIMIT 10;

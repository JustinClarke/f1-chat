  step 1 SQL: SELECT r.Abbreviation, d.full_name, r.TeamName, COUNT(*) as races, STDDEV(r.Position) as stddev_pos
FROM results r
JOIN driver_seasons d ON r.Abbreviation = d.driver_code AND r.season = d.season

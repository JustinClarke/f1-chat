 diff AS (
  SELECT f.race, ds.full_name AS driver, (w.winner_laps - f.driver_laps) AS laps_fewer
  FROM fin_laps f
  JOIN winner_laps w ON f.race = w.race
  JOIN driver_seasons ds ON ds.driver_code = f.Abbreviation AND ds.season=2024
  WHERE f.driver_laps < w.winner_laps
)
SELECT race, COUNT(*) AS num_drivers, string_agg(driver || ' (' || laps_fewer || ')', ', ') AS drivers
FROM diff
GROUP BY race
ORDER BY race;

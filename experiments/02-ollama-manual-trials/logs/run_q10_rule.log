QUESTION: Did any driver finish a 2024 race with fewer laps than the winner of that race? If so, list the driver, the race, and how many laps fewer.
== run 1 ==
    [model] done_reason=stop eval_count=1181 prompt_eval_count=3564 thinking_chars=3501 content_chars=0
  step 1 SQL: WITH winner_laps AS (
  SELECT r.race, r.Abbreviation AS winner_code, MAX(l.LapNumber) AS winner_laps
  FROM results r
  JOIN laps l ON l.Driver = r.Abbreviation AND l.race = r.race AND l.session='R'
  WHERE r.session='R' AND r.Position=1
  GROUP BY r.race, r.Abbreviation
),
 fin_laps AS (
  SELECT r.race, r.Abbreviation, MAX(l.LapNumber) AS driver_laps
  FROM results r
  JOIN laps l ON l.Driver = r.Abbreviation AND l.race = r.race AND l.session='R'
  WHERE r.session='R' AND (r.Status='Finished' OR r.Status='Lapped' OR r.Status LIKE '+%')
  GROUP BY r.race, r.Abbreviation
)
SELECT ds.full_name AS driver, w.race, (w.winner_laps - f.driver_laps) AS laps_fewer
FROM fin_laps f
JOIN winner_laps w ON f.race = w.race
JOIN driver_seasons ds ON ds.driver_code = f.Abbreviation AND ds.season=2024
WHERE f.driver_laps < w.winner_laps
ORDER BY w.race, laps_fewer DESC;

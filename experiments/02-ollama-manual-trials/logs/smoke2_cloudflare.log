  step 1 SQL: SELECT l.Driver, ds.full_name, COUNT(DISTINCT l.PitInTime) AS pit_stops
FROM laps l
JOIN driver_seasons ds ON l.Driver = ds.driver_code AND ds.season = 2024
WHERE l.race = 'bahrain_grand_prix' AND l.session = 'R' AND l.PitInTime IS NOT NULL
GROUP BY l.Driver, ds.full_name
ORDER BY pit_stops DESC
LIMIT 5;

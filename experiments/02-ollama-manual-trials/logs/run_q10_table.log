  step 1 SQL: WITH winner_laps AS (
  SELECT r.race, r.Abbreviation AS winner_abbrev, r.FullName AS winner_name, MAX(l.LapNumber) AS winner_laps
  FROM results r
  JOIN laps l ON r.race = l.race AND r.Abbreviation = l.Driver AND r.session = l.session
  WHERE r.session = 'R' AND r.Position = 1
  GROUP BY r.race, r.Abbreviation, r.FullName
), driver_laps AS (
  SELECT r.race, r.Abbreviation, r.FullName, MAX(l.LapNumber) AS driver_laps
  FROM results r
  JOIN laps l ON r.race = l.race AND r.Abbreviation = l.Driver AND r.session = l.session
  WHERE r.session = 'R'
    AND (r.Status = 'Finished' OR r.Status = 'Lapped' OR r.Status LIKE '+%')
  GROUP BY r.race, r.Abbreviation, r.FullName
)
SELECT dl.FullName AS driver, dl.race, (wl.winner_laps - dl.driver_laps) AS laps_fewer
FROM driver_laps dl
JOIN winner_laps wl ON dl.race = wl.race
WHERE dl.driver_laps < wl.winner_laps
ORDER BY dl.race, laps_fewer DESC;


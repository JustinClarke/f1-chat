QUESTION: Did any driver finish a 2024 race with fewer laps than the winner of that race? If so, list the driver, the race, and how many laps fewer.
== run 1 ==
    [model] done_reason=stop eval_count=1191 prompt_eval_count=3540 thinking_chars=3509 content_chars=0
  step 1 SQL: WITH winner_laps AS (
  SELECT r.race, r.race_id, MAX(l.LapNumber) AS winner_laps
  FROM results r
  JOIN laps l ON r.Abbreviation = l.Driver AND r.race_id = l.race_id
  WHERE r.session='R' AND r.Position=1
  GROUP BY r.race, r.race_id
)
SELECT d.full_name AS driver, r.race, (wl.winner_laps - MAX(l.LapNumber)) AS laps_fewer
FROM results r
JOIN laps l ON r.Abbreviation = l.Driver AND r.race_id = l.race_id
JOIN winner_laps wl ON r.race_id = wl.race_id
JOIN driver_seasons d ON r.Abbreviation = d.driver_code AND d.season=2024
WHERE r.session='R'
  AND r.Position <> 1
  AND (r.Status='Finished' OR r.Status='Lapped' OR r.Status LIKE '+%')
GROUP BY d.full_name, r.race, wl.winner_laps
HAVING (wl.winner_laps - MAX(l.LapNumber)) > 0
ORDER BY r.race, laps_fewer DESC;
